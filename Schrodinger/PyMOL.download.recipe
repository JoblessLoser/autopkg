<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Comment</key>
	<string>Created with Recipe Robot v2.5.0 (https://github.com/homebysix/recipe-robot)</string>
	<key>Description</key>
	<string>Downloads the latest version of PyMOL.</string>
	<key>Identifier</key>
	<string>com.github.JoblessLoser.download.PyMOL</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>PyMOL</string>
		<key>SUPPORTED_ARCH</key>
		<string>arm64</string>
		<!-- alt x86_64 -->
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>re_pattern</key>
				<string>PyMOL-([0-9._]*)-MacOS-.*\.dmg</string>
				<key>result_output_var_name</key>
				<string>DOWNLOADVERSION</string>
				<key>curl_opts</key>
					<array>
						<string>--location</string>
					</array>
				<key>url</key>
				<string>https://www.pymol.org/</string>
			</dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>filename</key>
				<string>%NAME%.dmg</string>
				<key>url</key>
				<string>https://storage.googleapis.com/pymol-storage/installers/PyMOL-%DOWNLOADVERSION%-MacOS-%SUPPORTED_ARCH%-py310.dmg</string>
			</dict>
			<key>Processor</key>
			<string>URLDownloader</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>input_path</key>
				<string>%pathname%/PyMOL.app</string>
				<key>requirement</key>
				<string>identifier "com.schrodinger.pymol" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = "26SDDJ756N"</string>
			</dict>
			<key>Processor</key>
			<string>CodeSignatureVerifier</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>input_plist_path</key>
				<string>%pathname%/PyMOL.app/Contents/Info.plist</string>
				<key>plist_version_key</key>
				<string>CFBundleShortVersionString</string>
			</dict>
			<key>Processor</key>
			<string>Versioner</string>
		</dict>
	</array>
</dict>
</plist>
